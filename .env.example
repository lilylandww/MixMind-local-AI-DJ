# Database. docker-compose.yml overrides to postgres:5432 inside the
# backend/worker containers; this localhost default is for the native
# worker and pytest run on the host.
DATABASE_URL=postgresql+psycopg://aidj:aidj@localhost:5432/aidj

# Redis / Celery broker. Same dual-host story as above.
REDIS_URL=redis://localhost:6379/0

# External APIs (stubbed in early phases)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GENIUS_ACCESS_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
# DigitalOcean Serverless Inference model access key (doo_v1_...).
DO_INFERENCE_API_KEY=

# LLM provider selection: gemini | groq | digitalocean
LLM_PROVIDER=digitalocean
# Only consumed when LLM_PROVIDER=groq. llama-4-scout is the default
# because it has 30K TPM on Groq's free tier (vs 8K for gpt-oss-120b
# or 12K for llama-3.3-70b) — 10x headroom for our trimmed prompt.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Only consumed when LLM_PROVIDER=digitalocean. OpenAI-compatible
# endpoint. gpt-oss-120b is the best model on the tier-1 subscription
# (GPT-5.x / Claude need a tier upgrade); set openai-gpt-5.5 after upgrading.
DO_INFERENCE_MODEL=openai-gpt-oss-120b
USE_LLM_PLANNER=True

# Storage backend: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./cache
CACHE_MAX_SIZE_GB=50
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION_NAME=

# Local-file import
MUSIC_MAX_UPLOAD_MB=300
# Optional: server-side folder import root (must exist inside the backend
# container, e.g. /music with `- ~/Music:/music:ro` in docker-compose.yml)
IMPORT_ROOT=

# Modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# yt-dlp cookies file. On cloud hosts (the droplet) YouTube's anti-bot
# system blocks datacenter IPs unless yt-dlp passes a logged-in browser
# session. Drop a Netscape cookies.txt at the path below; leave empty
# for local-dev (residential IP works without auth). Use a Chrome
# extension like "Get cookies.txt LOCALLY" to export from youtube.com.
YT_DLP_COOKIES_FILE=

# Frontend → backend base URL used by the browser (Client Components).
# Server Components inside the frontend container use BACKEND_URL instead,
# which is set in docker-compose.yml.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Model selection
DEMUCS_MODEL=htdemucs_ft
DEMUCS_DEVICE=mps           # mps | cuda | cpu

# --- Speech to text ----------------------------------------------------
# Whisper weights ("large-v3" is the tuned default; see
# backend/app/services/transcription/service.py for why turbo lost the
# A/B test). WHISPER_MODEL_REPO pins a specific HuggingFace MLX repo when
# the derived "mlx-community/whisper-<WHISPER_MODEL>-mlx" isn't what you
# want; leave empty to derive it.
WHISPER_MODEL=large-v3
WHISPER_MODEL_REPO=

# Pin the decode language. EMPTY (default) = auto-detect per song, which
# is what a multilingual queue needs — pinning "en" here would transcribe
# Japanese vocals as English gibberish. Set it only for a library you
# know is monolingual (it also skips the detect pass). A song with an
# .lrc in kana/Hangul/ideographs gets a per-song hint regardless.
WHISPER_LANGUAGE=

# Reuse known lyric text (.lrc sidecar / embedded lyrics) as the
# transcript and just ALIGN it to the audio instead of recognising it.
# Much faster (no decode), and the text cannot be misheard. Requires
# `uv sync --group worker` extras for torchaudio; falls back to Whisper
# automatically when the text is missing or the script isn't covered.
FORCED_ALIGN_ENABLED=false
FORCED_ALIGN_BACKEND=mms_fa

# Logging
LOG_LEVEL=INFO
